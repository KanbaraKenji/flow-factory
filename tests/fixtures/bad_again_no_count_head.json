"}, {"k": "short", "when": "库存不够", "to": "desk", "fault": {"kind": "human", "user_sees": "订单显示「备货中」，客服台多一件", "verdict": {"level": "risk", "note": "客服台没有超时提醒，订单可能一直停在备货中。建议：停留超过一天推一条提醒", "why": "客服台的待办只在后台列表里，没有推送也没有超时；代码里找不到任何提醒逻辑（代码推断，未看运行记录）"}}}]}, "pack": {"name": "打包", "kind": "hand", "does": "仓库人员按拣货单装箱、称重。", "input": "已锁定库存的订单", "output": "称好重的包裹", "default": "ok", "branches": [{"k": "ok", "when": "装箱完成", "to": "next"}], "unhandled": {"user_sees": "包裹漏装时顾客收到的东西不全，系统里看不出来", "verdict": {"level": "risk", "note": "全靠人工，没有核对。建议：加一步扫码核对件数"}}}, "label": {"name": "打面单", "kind": "step", "does": "调用快递接口生成运单号并打印面单。", "input": "称好重的包裹", "output": "贴好面单的包裹", "code": "server/ship.py:30 make_label()", "writes": [{"store": "courier", "what": "申请运单号"}, {"store": "labels", "what": "面单 PDF"}], "default": "ok", "branches": [{"k": "ok", "when": "快递接口返回运单号", "to": "next"}, {"k": "api_down", "when": "快递接口没响应", "to": "again", "end": {"kind": "wait", "label": "下一轮再申请"}, "fault": {"kind": "retry", "user_sees": "订单停在「打包完成」", "verdict": {"level": "risk", "note": "接口长时间不通时会一直重试，没人知道。建议：连续失败 3 次推一条提醒"}}}]}, "ship": {"name": "交快递", "kind": "out", "does": "快递员揽收，系统记录揽收时间并通知顾客。", "input": "贴好面单的包裹", "output": "在路上的包裹", "writes": [{"store": "db", "what": "orders.status = 已发货"}, {"store": "sms", "what": "给顾客发「已发货」短信"}], "irreversible": {"type": "send", "what": "给顾客发短信", "protection": {"level": "ok", "note": "同一单只在状态第一次变成已发货时发"}}, "default": "ok", "branches": [{"k": "ok", "when": "快递员扫码揽收", "to": "next"}], "unhandled": {"user_sees": "订单停在打好面单，顾客没收到短信", "verdict": {"level": "risk", "note": "出错去向没写。建议：揽收超时 24 小时转人工"}}}, "sign": {"name": "签收", "kind": "out", "does": "快递回传签收记录，订单完成。", "input": "在路上的包裹", "output": "顾客签收的包裹", "writes": [{"store": "db", "what": "orders.status = 已完成"}], "default": "ok", "branches": [{"k": "ok", "when": "快递回传签收", "to": "next"}, {"k": "lost", "when": "超过 15 天没有签收记录", "to": "end", "end": {"kind": "stuck", "label": "一直显示在路上"}, "fault": {"kind": "stuck", "user_sees": "订单永远显示